# Curated from gitignore.io/Toptal and GitHub gitignore templates for Vue/Vite.
# Keep package lockfiles and .env.example files tracked.

# OS files - macOS
.DS_Store
._*
.AppleDouble
.LSOverride
.DocumentRevisions-V100/
.fseventsd/
.Spotlight-V100/
.TemporaryItems/
.Trashes/
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder/
Temporary Items/
.apdisk
*.icloud
Icon?

# OS files - Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk
*.stackdump

# OS files - Linux
*~
.fuse_hidden*
.directory
.Trash-*/
.nfs*

